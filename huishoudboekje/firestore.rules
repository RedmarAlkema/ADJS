rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(data) {
      return signedIn() && data.ownerId == request.auth.uid;
    }

    match /budgetBooks/{bookId} {
      allow read: if owns(resource.data);

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.archived == false
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;

      allow update: if owns(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.archived is bool;

      allow delete: if false;
    }

    match /expenses/{expenseId} {
      allow read: if owns(resource.data);

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.budgetBookId is string
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;

      allow update: if false;
      allow delete: if owns(resource.data);
    }
  }
}
